    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.17.0",
    "tailwindcss": "^3.4.4",
    "zod": "^3.23.1"
  },
