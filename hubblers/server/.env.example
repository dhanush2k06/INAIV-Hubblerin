# ──────────────────────────────────────────────
# HubblerX Server — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# Server
PORT=4000

# JWT secret for signing tokens (generate a random 64+ char hex string)
JWT_SECRET=

# ──────────────────────────────────────────────
# Firebase Admin SDK
# ──────────────────────────────────────────────
# Option A: Point to the service account JSON file (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: Provide credentials inline (used when JSON file is unavailable)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Storage bucket name
FIREBASE_STORAGE_BUCKET=

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# Comma-separated list of additional allowed origins (optional)
# CORS_ORIGINS=http://localhost:5174,https://yourdomain.com

# ──────────────────────────────────────────────
# Vite API base (used by the frontend dev proxy)
# ──────────────────────────────────────────────
VITE_API_BASE=http://localhost:4000

# ──────────────────────────────────────────────
# SMTP (optional — for direct email sending)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────
# EmailJS (used for sending registration & event ticket emails)
# ──────────────────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_REPORT_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_REPLY_TO=
