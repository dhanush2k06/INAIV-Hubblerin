# ======================================================
# HubblerX — Root .gitignore
# ======================================================

# ──────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ──────────────────────────────────────────────────────
# Production build outputs
# ──────────────────────────────────────────────────────
dist/
**/dist/
dist-ssr/
**/dist-ssr/
dist-server/
**/dist-server/
*.tsbuildinfo
**/*.tsbuildinfo

# ──────────────────────────────────────────────────────
# Environment variables & secrets (CRITICAL)
# ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example
*.local
**/*.local

# ──────────────────────────────────────────────────────
# Firebase Service Account Credentials & Private Keys
# ──────────────────────────────────────────────────────
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
*serviceAccount*.json
**/*serviceAccount*.json
*.pem
**/*.pem
*.key
**/*.key

# ──────────────────────────────────────────────────────
# Logs & Temporary files
# ──────────────────────────────────────────────────────
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server-log.txt
**/server-log.txt
server_test.log
**/server_test.log
build-check-client.txt
**/build-check-client.txt

# ──────────────────────────────────────────────────────
# Editor & OS files
# ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ──────────────────────────────────────────────────────
# Testing & Coverage
# ──────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ──────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────
*.tgz
.cache/
.parcel-cache/
