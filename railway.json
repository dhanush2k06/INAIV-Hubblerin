{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd hubblers && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "cd hubblers && node dist-server/index.js",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
