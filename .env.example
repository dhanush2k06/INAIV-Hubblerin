# ==============================================================
# HubblerX — Unified Environment Variables (Docker & Local)
# ==============================================================
# Copy this file to .env at the project root for Docker Compose:
#   cp .env.example .env
#
# Or maintain separate .env files in:
#   - hubblers/server/.env (Backend API)
#   - hubblers/.env        (Main Frontend App)
#   - crm/.env             (CRM Dashboard)
# ==============================================================

# ── Backend Configuration ──
PORT=4000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_64_characters_hex_string_here

# ── Firebase Admin SDK (Server) ──
FIREBASE_PROJECT_ID=hubblers-9ff7b
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=hubblers-9ff7b.firebasestorage.app
# Optional: path to service account json if mounted inside container
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── CORS Settings ──
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── EmailJS Credentials (Optional for transactional emails) ──
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_REPORT_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_REPLY_TO=

# ── Client Frontend (Firebase Web SDK Config) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hubblers-9ff7b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hubblers-9ff7b
VITE_FIREBASE_STORAGE_BUCKET=hubblers-9ff7b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── API Base URL ──
VITE_API_BASE=http://localhost:4000
