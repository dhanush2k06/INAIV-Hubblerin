{
  "name": "hubblerx-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "hubblers",
    "crm"
  ],
  "scripts": {
    "build": "cd hubblers && npm run build",
    "build:all": "cd hubblers && npm run build && cd ../crm && npm run build",
    "build:backend": "cd hubblers && npx tsc -p server/tsconfig.json",
    "build:frontend": "cd hubblers && npm run build",
    "build:crm": "cd crm && npm run build",
    "start": "cd hubblers && node dist-server/index.js",
    "start:server": "cd hubblers && node dist-server/index.js"
  }
}
