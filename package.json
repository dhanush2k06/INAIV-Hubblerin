{
  "name": "hubblerx-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "hubblers",
    "crm"
  ],
  "scripts": {
    "dev": "npm run --prefix hubblers dev",
    "dev:all": "npm run --prefix hubblers dev:all",
    "dev:crm": "npm run --prefix crm dev",
    "dev:server": "npm run --prefix hubblers dev:server",
    "build": "npm run --prefix hubblers build",
    "build:all": "npm run --prefix hubblers build && npm run --prefix crm build",
    "build:backend": "npm run --prefix hubblers build:backend",
    "build:frontend": "npm run --prefix hubblers build:client",
    "build:crm": "npm run --prefix crm build",
    "start": "npm run --prefix hubblers start:server",
    "start:server": "npm run --prefix hubblers start:server",
    "seed:admin": "npm run --prefix hubblers seed:admin",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build"
  }
}
